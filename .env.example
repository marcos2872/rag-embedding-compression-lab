EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DEVICE=cpu          # cpu | cuda | mps
RANDOM_SEED=42
QJL_SEED=123
CORPUS_PATH=data/corpus.jsonl
QUERIES_PATH=data/queries.jsonl

# ── LLM (RAG Demo) ──────────────────────────────────────────────

# Opção 1 — Ollama local (padrão: http://localhost:11434)
LLM_BACKEND=ollama
LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434   # troque se rodar em outra porta ou máquina

# Opção 2 — OpenRouter (ou qualquer API compatível com OpenAI)
# LLM_BACKEND=openai
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-troque-pela-sua-chave
# LLM_MODEL=meta-llama/llama-3.2-3b-instruct:free
